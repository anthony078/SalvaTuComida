<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <!-- Hacer referencia explícita al certificado de Visual Studio incrustado en la aplicación -->
            <certificates src="@raw/debug_cert" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>