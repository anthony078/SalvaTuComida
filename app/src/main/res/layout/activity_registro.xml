<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Crear Cuenta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1D4327"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/edtNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtApellido"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Apellido"
            android:inputType="textPersonName"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtCorreoReg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Correo (solo @gmail.com)"
            android:inputType="textEmailAddress"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtPasswordReg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Contraseña segura"
            android:inputType="textPassword"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mín. 8 caracteres, 1 mayúscula, 1 minúscula y 1 número."
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp"/>

        <EditText
            android:id="@+id/edtConfirmarPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Confirmar contraseña"
            android:inputType="textPassword"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnRegistrarFinal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Registrarse"
            android:backgroundTint="#E67E22"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Volver al Login"
            android:backgroundTint="#1D4327"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>